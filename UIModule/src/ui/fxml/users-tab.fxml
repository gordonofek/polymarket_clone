<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<SplitPane dividerPositions="0.25" prefHeight="160.0" prefWidth="200.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.UsersTabController">
   <items>
      <!-- LEFT SIDE: Public Users Directory -->
      <VBox spacing="10.0" styleClass="card-panel">
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
         <children>
            <Label styleClass="event-title-label" text="Public Directory" />
            <Label text="Select a user to view the events they manage." styleClass="event-desc-label" wrapText="true"/>

            <TableView fx:id="usersTableView" styleClass="borderless-list-view" VBox.vgrow="ALWAYS">
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
               <columns>
                  <TableColumn fx:id="userNameCol" prefWidth="180.0" reorderable="false" text="User Name" />
                  <TableColumn fx:id="userBalanceCol" prefWidth="120.0" reorderable="false" text="Balance" />
               </columns>
            </TableView>
         </children>
      </VBox>

      <!-- RIGHT SIDE: Public User Info & MM Events -->
      <VBox spacing="20.0">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>
            <!-- Top Card: Selected User Banner -->
            <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="card-panel, user-banner">
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>
               <children>
                  <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label text="Viewing Profile:" styleClass="comm-title-label"/>
                        <Label fx:id="userNameLabel" styleClass="main-app-title" text="Select a user...">
                           <font>
                              <Font name="System Bold" size="32.0" />
                           </font>
                        </Label>
                     </children>
                  </VBox>
                  <VBox alignment="CENTER_RIGHT" spacing="5.0">
                     <children>
                        <Label text="Available Balance:" styleClass="comm-title-label"/>
                        <Label fx:id="userBalanceLabel" styleClass="option-price-label" text="\$0.00">
                           <font>
                              <Font name="System Bold" size="24.0" />
                           </font>
                        </Label>
                     </children>
                  </VBox>
               </children>
            </HBox>

            <!-- Bottom Card: Market Maker Events -->
            <VBox spacing="10.0" styleClass="card-panel" VBox.vgrow="ALWAYS">
               <padding>
                  <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
               </padding>
               <children>
                  <Label styleClass="event-title-label" text="Market Maker Events" />
                  <Label text="Events currently managed by this user." styleClass="event-desc-label" />

                  <TableView fx:id="mmEventsTableView" styleClass="borderless-list-view" VBox.vgrow="ALWAYS">
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                     <columns>
                        <TableColumn fx:id="mmEventIdCol" prefWidth="80.0" reorderable="false" text="ID" />
                        <TableColumn fx:id="mmEventNameCol" prefWidth="300.0" reorderable="false" text="Event Name" />
                        <TableColumn fx:id="mmEventStatusCol" prefWidth="150.0" reorderable="false" text="Status" />
                        <TableColumn fx:id="mmEventMethodCol" prefWidth="150.0" reorderable="false" text="Trading Method" />
                     </columns>
                  </TableView>
               </children>
            </VBox>
         </children>
      </VBox>
   </items>
</SplitPane>